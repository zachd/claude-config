# Ignore everything by default
/*

# ...except what we explicitly track
!.gitignore
!README.md
!skills/

# Track only the constrained /deliver orchestrator agent, not all of agents/
!/agents/
/agents/*
!/agents/deliver-orchestrator.md

# Same for hooks/: only the orchestrator write guard, not local hooks
!/hooks/
/hooks/*
!/hooks/deliver-orchestrator-guard.sh

# Never track macOS cruft, even inside tracked dirs
**/.DS_Store
